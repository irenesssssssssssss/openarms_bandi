APP_HOST=127.0.0.1
APP_PORT=8000
UPDATE_INTERVAL_MINUTES=60
REFRESH_ON_STARTUP=true

# Networking / cortesia verso le fonti
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
REQUEST_DELAY_SECONDS=0.8
# Inserisci un contatto reale dell'organizzazione se desiderato.
USER_AGENT=OpenArmsGrantMonitor/0.1 (non-commercial grant monitoring)
# Se true, un robots.txt irraggiungibile blocca lo scraping. Un Disallow esplicito blocca comunque la fonte.
ROBOTS_STRICT=false

# CSV Lazio ha uno storico profondo; le schede attive già conosciute vengono sempre ricontrollate.
CSV_LAZIO_MAX_PAGES=15
INFOBANDI_MAX_PAGES=10
CONFINIONLINE_MAX_PAGES=12

# Soglia minima mostrata nella dashboard (BASSA parte da 12)
RELEVANCE_MIN_VISIBLE_SCORE=12

# Impostare solo se verificato per Open Arms Italia: yes / no / unknown
OPEN_ARMS_RUNTS=unknown
OPEN_ARMS_ASSOCIATION_REGISTER=unknown
OPEN_ARMS_REGIONS=Italia

# Google Sheets opzionale
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Bandi
GOOGLE_SERVICE_ACCOUNT_FILE=

# Nuove fonti (v0.2) - facoltativo: i default funzionano anche con il vecchio .env
ADDITIONAL_MAX_PAGES=3
ADDITIONAL_MAX_DETAILS=35
EU_MAX_PAGES_PER_QUERY=3
EU_PAGE_SIZE=50
REFRESH_MAX_WORKERS=3
